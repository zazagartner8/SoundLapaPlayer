rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidHandle(handle) {
      return handle is string && handle.matches('^[a-z0-9_]{3,24}$');
    }

    function hasSoundLapUidPrefix(prefix) {
      return isSignedIn() &&
        hashing.sha256('soundlap_uid_v1:' + request.auth.uid).toHexString().lower().matches('^' + prefix + '.*');
    }

    function isVerifiedDeveloper() {
      return isSignedIn() && (
        (
          request.auth.token.email is string &&
          hashing.sha256(request.auth.token.email.lower()).toHexString().lower() == '15f1e7a5e2780e58b8f5fdb2bf5fd811e841467762a079169d03c1d8552479d3' &&
          request.auth.token.email_verified == true
        ) ||
        hasSoundLapUidPrefix('d1e6ee60')
      );
    }

    function isVerifiedModerator() {
      return isSignedIn() && (
        hasSoundLapUidPrefix('c526964c') ||
        hasSoundLapUidPrefix('6721beed')
      );
    }

    function isAvatarReviewer() {
      return isVerifiedDeveloper() || isVerifiedModerator();
    }

    function isNotBanned() {
      return isSignedIn() &&
        !exists(/databases/$(database)/documents/banned_users/$(request.auth.uid));
    }

    function isValidBanRecord(userId, data) {
      return data.userId is string && data.userId == userId && isValidId(userId) &&
        data.bannedByUid is string && data.bannedByUid == request.auth.uid &&
        data.bannedAtMs is int && data.bannedAtMs >= 0 &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 300));
    }

    function isValidUserSettings(s) {
      return s is map &&
        s.keys().hasOnly([
          'appLanguage', 'darkLiquidGlass', 'accentColorArgb',
          'smoothTransitionEnabled', 'smoothTransitionDurationSec',
          'hapticsEnabled', 'hapticIntensity',
          'autoCacheOnPlay', 'dataSaverEnabled', 'autoUploadEnabled',
          'batterySaverEnabled', 'audioFocusMode',
          'updatedAtMs'
        ]) &&
        (!('appLanguage' in s) || (s.appLanguage is string && s.appLanguage.size() >= 2 && s.appLanguage.size() <= 10)) &&
        (!('darkLiquidGlass' in s) || s.darkLiquidGlass is bool) &&
        (!('accentColorArgb' in s) || s.accentColorArgb is int) &&
        (!('smoothTransitionEnabled' in s) || s.smoothTransitionEnabled is bool) &&
        (!('smoothTransitionDurationSec' in s) || (s.smoothTransitionDurationSec is int && s.smoothTransitionDurationSec >= 1 && s.smoothTransitionDurationSec <= 10)) &&
        (!('hapticsEnabled' in s) || s.hapticsEnabled is bool) &&
        (!('hapticIntensity' in s) || (s.hapticIntensity is int && s.hapticIntensity >= 10 && s.hapticIntensity <= 100)) &&
        (!('autoCacheOnPlay' in s) || s.autoCacheOnPlay is bool) &&
        (!('dataSaverEnabled' in s) || s.dataSaverEnabled is bool) &&
        (!('autoUploadEnabled' in s) || s.autoUploadEnabled is bool) &&
        (!('batterySaverEnabled' in s) || s.batterySaverEnabled is bool) &&
        (!('audioFocusMode' in s) || (s.audioFocusMode is string && s.audioFocusMode in ['PAUSE', 'DUCK', 'MIX'])) &&
        (!('updatedAtMs' in s) || (s.updatedAtMs is int && s.updatedAtMs >= 0));
    }

    function isValidUserProfile(userId, data) {
      return data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('username' in data) || isValidHandle(data.username)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 100000)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
        (!('avatarBlocked' in data) || data.avatarBlocked is bool) &&
        (!('avatarBlocked' in data) || !data.avatarBlocked || !('photoUrl' in data)) &&
        (!('accountUid' in data) || (data.accountUid is string && data.accountUid.size() >= 3 && data.accountUid.size() <= 32)) &&
        (!('searchHistory' in data) || (data.searchHistory is list && data.searchHistory.size() <= 30)) &&
        (!('listeningStatsJson' in data) || (data.listeningStatsJson is string && data.listeningStatsJson.size() <= 80000)) &&
        (!('settings' in data) || isValidUserSettings(data.settings)) &&
        (!('isOnline' in data) || data.isOnline is bool) &&
        (!('lastActiveAtMs' in data) || (data.lastActiveAtMs is int && data.lastActiveAtMs >= 0)) &&
        (!('currentTrackId' in data) || (data.currentTrackId is string && data.currentTrackId.size() <= 200)) &&
        (!('currentTrackTitle' in data) || (data.currentTrackTitle is string && data.currentTrackTitle.size() <= 200)) &&
        (!('currentTrackArtist' in data) || (data.currentTrackArtist is string && data.currentTrackArtist.size() <= 200)) &&
        (!('currentTrackCoverUrl' in data) || (data.currentTrackCoverUrl is string && data.currentTrackCoverUrl.size() <= 1000)) &&
        (!('currentTrackIsPlaying' in data) || data.currentTrackIsPlaying is bool) &&
        (!('currentTrackUpdatedAtMs' in data) || (data.currentTrackUpdatedAtMs is int && data.currentTrackUpdatedAtMs >= 0)) &&
        (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 32));
    }

    function isValidBugReport(data) {
      return data.reportId is string && data.reportId.size() >= 1 && data.reportId.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 100 &&
        (!('reporterAvatarUrl' in data) || (data.reporterAvatarUrl is string && data.reporterAvatarUrl.size() <= 100000)) &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 64 &&
        (!('status' in data) || (data.status is string && data.status in ['open', 'in_progress', 'resolved'])) &&
        data.createdAtMs is int && data.createdAtMs >= 0;
    }

    function isValidBugReportUpdate(data) {
      return data.reportId is string && data.reportId.size() >= 1 && data.reportId.size() <= 128 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 100 &&
        (!('reporterAvatarUrl' in data) || (data.reporterAvatarUrl is string && data.reporterAvatarUrl.size() <= 100000)) &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 64 &&
        data.status is string && data.status in ['open', 'in_progress', 'resolved'] &&
        data.createdAtMs is int && data.createdAtMs >= 0;
    }

    function isValidAvatarRequest(userId, data) {
      return data.userId is string && data.userId == userId && isValidId(userId) &&
        data.accountUid is string && data.accountUid.size() >= 3 && data.accountUid.size() <= 32 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('username' in data) || isValidHandle(data.username)) &&
        (!('currentPhotoUrl' in data) || (data.currentPhotoUrl is string && data.currentPhotoUrl.size() <= 100000)) &&
        data.proposedPhotoUrl is string && data.proposedPhotoUrl.size() >= 1 && data.proposedPhotoUrl.size() <= 100000 &&
        data.status is string && data.status in ['pending', 'approved', 'rejected'] &&
        (!('rejectReason' in data) || (data.rejectReason is string && data.rejectReason.size() <= 300)) &&
        (!('reviewedByUid' in data) || (data.reviewedByUid is string && data.reviewedByUid.size() >= 1 && data.reviewedByUid.size() <= 128)) &&
        (!('reviewedByName' in data) || (data.reviewedByName is string && data.reviewedByName.size() >= 1 && data.reviewedByName.size() <= 100)) &&
        data.createdAtMs is int && data.createdAtMs >= 0 &&
        (!('reviewedAtMs' in data) || (data.reviewedAtMs is int && data.reviewedAtMs >= 0));
    }

    function isValidSavedTrack(data) {
      return data.userId is string && data.userId == request.auth.uid &&
        data.trackId is string && data.trackId.size() >= 1 && data.trackId.size() <= 200 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 200 &&
        data.genre is string && data.genre.size() <= 80 &&
        data.durationMs is int && data.durationMs >= 0 &&
        (!('sourceUri' in data) || (data.sourceUri is string && data.sourceUri.size() <= 1000)) &&
        (!('coverArtPath' in data) || (data.coverArtPath is string && data.coverArtPath.size() <= 1000)) &&
        data.accentColorHex is int &&
        data.secondaryColorHex is int &&
        data.isUserUpload is bool &&
        data.isLiked is bool &&
        data.playCount is int && data.playCount >= 0 &&
        data.likeCount is int && data.likeCount >= 0 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('albumTitle' in data) || (data.albumTitle is string && data.albumTitle.size() <= 200)) &&
        data.trackCreatedAtMs is int && data.trackCreatedAtMs >= 0;
    }

    function isValidUserPlaylist(data) {
      return data.userId is string && data.userId == request.auth.uid &&
        data.playlistId is string && data.playlistId.size() >= 1 && data.playlistId.size() <= 160 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('coverArtPath' in data) || (data.coverArtPath is string && data.coverArtPath.size() <= 1000)) &&
        (!('isPinned' in data) || data.isPinned is bool) &&
        (!('pinnedAtMs' in data) || (data.pinnedAtMs is int && data.pinnedAtMs >= 0)) &&
        (!('sortMode' in data) || (data.sortMode is string && data.sortMode.size() >= 1 && data.sortMode.size() <= 32)) &&
        data.playlistCreatedAtMs is int && data.playlistCreatedAtMs >= 0;
    }

    function isValidUserPlaylistItem(data) {
      return data.userId is string && data.userId == request.auth.uid &&
        data.playlistId is string && data.playlistId.size() >= 1 && data.playlistId.size() <= 160 &&
        data.trackId is string && data.trackId.size() >= 1 && data.trackId.size() <= 200 &&
        data.position is int && data.position >= 0 &&
        data.addedAtMs is int && data.addedAtMs >= 0;
    }

    function isValidCloudMetrics(data) {
      return data.userId is string && data.userId == request.auth.uid &&
        data.storageBytes is int && data.storageBytes >= 0 && data.storageBytes <= 10737418240 &&
        data.tracksCount is int && data.tracksCount >= 0 && data.tracksCount <= 100000 &&
        data.playlistsCount is int && data.playlistsCount >= 0 && data.playlistsCount <= 50000;
    }

    function isValidPublicProfile(userId, data, allowReviewerRoleFlags) {
      return data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('username' in data) || isValidHandle(data.username)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 100000)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
        data.isDeveloper is bool && (allowReviewerRoleFlags || !data.isDeveloper || isVerifiedDeveloper()) &&
        (!('isModerator' in data) || (data.isModerator is bool && (allowReviewerRoleFlags || !data.isModerator || isVerifiedModerator()))) &&
        data.isPublic is bool && data.isPublic == true;
    }

    function isValidUsernameDoc(handle, data, allowReviewerRoleFlags) {
      return data.username is string && data.username == handle && isValidHandle(data.username) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 100000)) &&
        data.isDeveloper is bool && (allowReviewerRoleFlags || !data.isDeveloper || isVerifiedDeveloper()) &&
        (!('isModerator' in data) || (data.isModerator is bool && (allowReviewerRoleFlags || !data.isModerator || isVerifiedModerator()))) &&
        data.isPublic is bool && data.isPublic == true;
    }

    function isValidFriendDoc(userId, friendUid, data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId == userId &&
        data.friendUid is string && data.friendUid == friendUid && isValidId(data.friendUid) &&
        data.friendUid != userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('username' in data) || isValidHandle(data.username)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 100000)) &&
        data.isDeveloper is bool &&
        (!('isModerator' in data) || data.isModerator is bool) &&
        data.addedAtMs is int && data.addedAtMs >= 0;
    }

    function isValidArtistSubscriptionDoc(userId, artistKey, data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId == userId &&
        data.artistKey is string && data.artistKey == artistKey && isValidId(data.artistKey) &&
        data.artistName is string && data.artistName.size() >= 1 && data.artistName.size() <= 160 &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
        (!('soundCloudUrl' in data) || (data.soundCloudUrl is string && data.soundCloudUrl.size() <= 1000)) &&
        (!('spotifyArtistId' in data) || (data.spotifyArtistId is string && data.spotifyArtistId.size() <= 200)) &&
        data.subscribedAtMs is int && data.subscribedAtMs >= 0;
    }

    match /users/{userId} {
      allow get: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(userId);
      allow list: if (isOwner(userId) && isNotBanned()) || isVerifiedDeveloper();

      allow create: if isOwner(userId) &&
        isNotBanned() &&
        isValidId(userId) &&
        incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'username', 'email', 'photoUrl', 'bio', 'avatarBlocked',
          'accountUid', 'searchHistory', 'listeningStatsJson', 'settings',
          'isOnline', 'lastActiveAtMs', 'currentTrackId', 'currentTrackTitle',
          'currentTrackArtist', 'currentTrackCoverUrl', 'currentTrackIsPlaying',
          'currentTrackUpdatedAtMs', 'appVersion', 'createdAt', 'updatedAt'
        ]) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidUserProfile(userId, incoming());

      allow update: if isValidId(userId) &&
        isValidUserProfile(userId, incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        (
          (
            isOwner(userId) &&
            isNotBanned() &&
            (!('avatarBlocked' in existing()) || !existing().avatarBlocked || (incoming().avatarBlocked == true && !('photoUrl' in incoming()))) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'username', 'email', 'photoUrl', 'bio', 'avatarBlocked',
              'accountUid', 'searchHistory', 'listeningStatsJson', 'settings',
              'isOnline', 'lastActiveAtMs', 'currentTrackId', 'currentTrackTitle',
              'currentTrackArtist', 'currentTrackCoverUrl', 'currentTrackIsPlaying',
              'currentTrackUpdatedAtMs', 'appVersion', 'updatedAt'
            ])
          ) ||
          (
            isAvatarReviewer() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['photoUrl', 'avatarBlocked', 'updatedAt'])
          )
        );

      allow delete: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(userId);

      match /tracks/{trackDocId} {
        allow get: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(trackDocId);
        allow list: if (isOwner(userId) && isNotBanned()) || isVerifiedDeveloper();

        allow create: if isOwner(userId) &&
          isNotBanned() &&
          isValidId(trackDocId) &&
          incoming().keys().hasAll([
            'userId', 'trackId', 'title', 'artist', 'genre', 'durationMs',
            'accentColorHex', 'secondaryColorHex', 'isUserUpload', 'isLiked',
            'playCount', 'likeCount', 'trackCreatedAtMs', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'trackId', 'title', 'artist', 'genre', 'durationMs',
            'sourceUri', 'coverArtPath', 'accentColorHex', 'secondaryColorHex',
            'isUserUpload', 'isLiked', 'playCount', 'likeCount', 'description',
            'albumTitle', 'trackCreatedAtMs', 'createdAt', 'updatedAt'
          ]) &&
          incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          isValidSavedTrack(incoming());

        allow update: if isOwner(userId) &&
          isNotBanned() &&
          isValidId(trackDocId) &&
          isValidSavedTrack(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().trackId == existing().trackId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'artist', 'genre', 'durationMs', 'sourceUri', 'coverArtPath',
            'accentColorHex', 'secondaryColorHex', 'isUserUpload', 'isLiked',
            'playCount', 'likeCount', 'description', 'albumTitle', 'trackCreatedAtMs', 'updatedAt'
          ]);

        allow delete: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(trackDocId);
      }

      match /playlists/{playlistDocId} {
        allow get: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(playlistDocId);
        allow list: if (isOwner(userId) && isNotBanned()) || isVerifiedDeveloper();

        allow create: if isOwner(userId) &&
          isNotBanned() &&
          isValidId(playlistDocId) &&
          incoming().keys().hasAll([
            'userId', 'playlistId', 'name', 'playlistCreatedAtMs', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'playlistId', 'name', 'description', 'coverArtPath',
            'isPinned', 'pinnedAtMs', 'sortMode',
            'playlistCreatedAtMs', 'createdAt', 'updatedAt'
          ]) &&
          incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          isValidUserPlaylist(incoming());

        allow update: if isOwner(userId) &&
          isNotBanned() &&
          isValidId(playlistDocId) &&
          isValidUserPlaylist(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().playlistId == existing().playlistId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'coverArtPath',
            'isPinned', 'pinnedAtMs', 'sortMode',
            'playlistCreatedAtMs', 'updatedAt'
          ]);

        allow delete: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(playlistDocId);

        match /items/{itemDocId} {
          allow get: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(playlistDocId) && isValidId(itemDocId);
          allow list: if (isOwner(userId) && isNotBanned()) || isVerifiedDeveloper();

          allow create: if isOwner(userId) &&
            isNotBanned() &&
            isValidId(playlistDocId) &&
            isValidId(itemDocId) &&
            isValidUserPlaylistItem(incoming()) &&
            incoming().keys().hasAll([
              'userId', 'playlistId', 'trackId', 'position', 'addedAtMs', 'createdAt', 'updatedAt'
            ]) &&
            incoming().keys().hasOnly([
              'userId', 'playlistId', 'trackId', 'position', 'addedAtMs', 'createdAt', 'updatedAt'
            ]) &&
            incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
            incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
            (
              exists(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistDocId)) ||
              existsAfter(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistDocId))
            );

          allow update: if isOwner(userId) &&
            isNotBanned() &&
            isValidId(playlistDocId) &&
            isValidId(itemDocId) &&
            isValidUserPlaylistItem(incoming()) &&
            incoming().userId == existing().userId &&
            incoming().playlistId == existing().playlistId &&
            incoming().trackId == existing().trackId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['position', 'addedAtMs', 'updatedAt']);

          allow delete: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(playlistDocId) && isValidId(itemDocId);
        }
      }

      match /friends/{friendUid} {
        allow get: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(friendUid);
        allow list: if (isOwner(userId) && isNotBanned()) || isVerifiedDeveloper();

        allow create: if isOwner(userId) &&
          isNotBanned() &&
          isValidId(friendUid) &&
          incoming().keys().hasAll([
            'userId', 'friendUid', 'displayName', 'isDeveloper', 'addedAtMs', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'friendUid', 'username', 'displayName', 'photoUrl', 'isDeveloper', 'isModerator',
            'addedAtMs', 'createdAt', 'updatedAt'
          ]) &&
          incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          isValidFriendDoc(userId, friendUid, incoming());

        allow update: if isOwner(userId) &&
          isNotBanned() &&
          isValidId(friendUid) &&
          isValidFriendDoc(userId, friendUid, incoming()) &&
          incoming().userId == existing().userId &&
          incoming().friendUid == existing().friendUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'username', 'displayName', 'photoUrl', 'isDeveloper', 'isModerator', 'addedAtMs', 'updatedAt'
          ]);

        allow delete: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(friendUid);
      }

      match /artist_subscriptions/{artistKey} {
        allow get: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(artistKey);
        allow list: if (isOwner(userId) && isNotBanned()) || isVerifiedDeveloper();

        allow create: if isOwner(userId) &&
          isNotBanned() &&
          isValidId(artistKey) &&
          incoming().keys().hasAll([
            'userId', 'artistKey', 'artistName', 'subscribedAtMs', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'artistKey', 'artistName', 'avatarUrl', 'soundCloudUrl', 'spotifyArtistId',
            'subscribedAtMs', 'createdAt', 'updatedAt'
          ]) &&
          incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          isValidArtistSubscriptionDoc(userId, artistKey, incoming());

        allow update: if isOwner(userId) &&
          isNotBanned() &&
          isValidId(artistKey) &&
          isValidArtistSubscriptionDoc(userId, artistKey, incoming()) &&
          incoming().userId == existing().userId &&
          incoming().artistKey == existing().artistKey &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'artistName', 'avatarUrl', 'soundCloudUrl', 'spotifyArtistId', 'subscribedAtMs', 'updatedAt'
          ]);

        allow delete: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(artistKey);
      }
    }

    match /public_profiles/{userId} {
      allow get: if isNotBanned() && isValidId(userId);
      allow list: if isNotBanned() && (existing().isPublic == true || existing().isDeveloper == true);

      allow create: if isOwner(userId) &&
        isNotBanned() &&
        isValidId(userId) &&
        incoming().keys().hasAll([
          'userId', 'displayName', 'isDeveloper', 'isPublic', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'username', 'photoUrl', 'bio', 'isDeveloper', 'isModerator', 'isPublic', 'updatedAt'
        ]) &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidPublicProfile(userId, incoming(), false);

      allow update: if isValidId(userId) &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        incoming().userId == existing().userId &&
        (
          (
            isOwner(userId) &&
            isNotBanned() &&
            incoming().keys().hasAll([
              'userId', 'displayName', 'isDeveloper', 'isPublic', 'updatedAt'
            ]) &&
            incoming().keys().hasOnly([
              'userId', 'displayName', 'username', 'photoUrl', 'bio', 'isDeveloper', 'isModerator', 'isPublic', 'updatedAt'
            ]) &&
            isValidPublicProfile(userId, incoming(), false)
          ) ||
          (
            isAvatarReviewer() &&
            isValidPublicProfile(userId, incoming(), true) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['photoUrl', 'updatedAt'])
          )
        );

      allow delete: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(userId);
    }

    match /usernames/{handle} {
      allow get: if (isNotBanned() || isAvatarReviewer()) && isValidHandle(handle);
      allow list: if (isNotBanned() && existing().isPublic == true) || isVerifiedDeveloper();

      allow create: if isNotBanned() &&
        isValidHandle(handle) &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll([
          'username', 'userId', 'displayName', 'isDeveloper', 'isPublic', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'username', 'userId', 'displayName', 'photoUrl', 'isDeveloper', 'isModerator', 'isPublic', 'updatedAt'
        ]) &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidUsernameDoc(handle, incoming(), false);

      allow update: if isValidHandle(handle) &&
        incoming().userId == existing().userId &&
        incoming().username == existing().username &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        (
          (
            isNotBanned() &&
            existing().userId == request.auth.uid &&
            incoming().keys().hasAll([
              'username', 'userId', 'displayName', 'isDeveloper', 'isPublic', 'updatedAt'
            ]) &&
            incoming().keys().hasOnly([
              'username', 'userId', 'displayName', 'photoUrl', 'isDeveloper', 'isModerator', 'isPublic', 'updatedAt'
            ]) &&
            isValidUsernameDoc(handle, incoming(), false)
          ) ||
          (
            isAvatarReviewer() &&
            isValidUsernameDoc(handle, incoming(), true) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['photoUrl', 'updatedAt'])
          )
        );

      allow delete: if isValidHandle(handle) &&
        ((isNotBanned() && existing().userId == request.auth.uid) || isVerifiedDeveloper());
    }

    match /bug_reports/{reportId} {
      allow get: if isSignedIn() &&
        isValidId(reportId) &&
        ((isNotBanned() && existing().userId == request.auth.uid) || isVerifiedDeveloper());

      allow list: if isSignedIn() &&
        ((isNotBanned() && existing().userId == request.auth.uid) || isVerifiedDeveloper());

      allow create: if isNotBanned() &&
        isValidId(reportId) &&
        incoming().keys().hasAll([
          'reportId', 'userId', 'reporterName', 'message',
          'appVersion', 'createdAtMs', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'reportId', 'userId', 'reporterName', 'reporterAvatarUrl', 'message',
          'appVersion', 'status', 'createdAtMs', 'createdAt'
        ]) &&
        (!('status' in incoming()) || incoming().status == 'open') &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        isValidBugReport(incoming());

      allow update: if isVerifiedDeveloper() &&
        isValidId(reportId) &&
        isValidBugReportUpdate(incoming()) &&
        incoming().reportId == existing().reportId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() &&
        isValidId(reportId) &&
        ((isNotBanned() && existing().userId == request.auth.uid) || isVerifiedDeveloper());
    }

    match /avatar_requests/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        ((isOwner(userId) && isNotBanned()) || isAvatarReviewer());

      allow list: if isSignedIn() &&
        ((isNotBanned() && existing().userId == request.auth.uid) || isAvatarReviewer());

      allow create: if isOwner(userId) &&
        isNotBanned() &&
        isValidId(userId) &&
        incoming().keys().hasAll([
          'userId', 'accountUid', 'displayName', 'proposedPhotoUrl',
          'status', 'createdAtMs', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'accountUid', 'displayName', 'username', 'currentPhotoUrl',
          'proposedPhotoUrl', 'status', 'createdAtMs', 'createdAt', 'updatedAt'
        ]) &&
        incoming().status == 'pending' &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidAvatarRequest(userId, incoming());

      allow update: if isValidId(userId) &&
        isValidAvatarRequest(userId, incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        (
          (
            isOwner(userId) &&
            isNotBanned() &&
            incoming().status == 'pending' &&
            !('rejectReason' in incoming()) &&
            !('reviewedByUid' in incoming()) &&
            !('reviewedByName' in incoming()) &&
            !('reviewedAtMs' in incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'accountUid', 'displayName', 'username', 'currentPhotoUrl',
              'proposedPhotoUrl', 'status', 'createdAtMs', 'updatedAt',
              'rejectReason', 'reviewedByUid', 'reviewedByName', 'reviewedAtMs'
            ])
          ) ||
          (
            isAvatarReviewer() &&
            incoming().status in ['approved', 'rejected'] &&
            incoming().reviewedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'rejectReason', 'reviewedByUid', 'reviewedByName', 'reviewedAtMs', 'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(userId) &&
        ((isOwner(userId) && isNotBanned()) || isAvatarReviewer());
    }

    match /cloud_metrics/{userId} {
      allow get: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(userId);
      allow list: if isVerifiedDeveloper();

      allow create: if isOwner(userId) &&
        isNotBanned() &&
        isValidId(userId) &&
        incoming().keys().hasAll([
          'userId', 'storageBytes', 'tracksCount', 'playlistsCount', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'storageBytes', 'tracksCount', 'playlistsCount', 'updatedAt'
        ]) &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidCloudMetrics(incoming());

      allow update: if isOwner(userId) &&
        isNotBanned() &&
        isValidId(userId) &&
        incoming().keys().hasOnly([
          'userId', 'storageBytes', 'tracksCount', 'playlistsCount', 'updatedAt'
        ]) &&
        incoming().userId == existing().userId &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidCloudMetrics(incoming());

      allow delete: if ((isOwner(userId) && isNotBanned()) || isVerifiedDeveloper()) && isValidId(userId);
    }

    match /banned_users/{userId} {
      allow get: if (isOwner(userId) || isVerifiedDeveloper()) && isValidId(userId);
      allow list: if isVerifiedDeveloper();

      allow create, update: if isVerifiedDeveloper() &&
        isValidId(userId) &&
        userId != request.auth.uid &&
        incoming().keys().hasAll(['userId', 'bannedByUid', 'bannedAtMs', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'reason', 'bannedByUid', 'bannedAtMs', 'updatedAt']) &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidBanRecord(userId, incoming());

      allow delete: if isVerifiedDeveloper() && isValidId(userId);
    }
  }
}
