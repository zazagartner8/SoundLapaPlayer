{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Google user profile, custom identity, and synced app settings for SoundLapa",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the signed-in Google user"
        },
        "displayName": {
          "type": "string",
          "description": "User display name or custom nickname"
        },
        "username": {
          "type": "string",
          "description": "Optional unique public @username handle"
        },
        "email": {
          "type": "string",
          "description": "Optional user email (private to owner only)"
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional avatar URL or compressed JPEG data URI"
        },
        "bio": {
          "type": "string",
          "description": "Optional user profile description / bio"
        },
        "avatarBlocked": {
          "type": "boolean",
          "description": "Whether custom avatar uploads are permanently blocked for this account due to 18+ moderation violation"
        },
        "accountUid": {
          "type": "string",
          "description": "Deterministic shareable SoundLap account UID (SL-XXXX-XXXX)"
        },
        "searchHistory": {
          "type": "array",
          "description": "Recent cloud-synced search queries (max 30)"
        },
        "listeningStatsJson": {
          "type": "string",
          "description": "Compact JSON array of 365-day daily listening events for cross-device stats sync"
        },
        "settings": {
          "type": "object",
          "description": "Cloud-synced SoundLapa preferences (language, theme, accent color, crossfade, haptics, cache, data saver)"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Whether user session is currently in foreground"
        },
        "lastActiveAtMs": {
          "type": "integer",
          "description": "Client epoch milliseconds when presence or playback state changed"
        },
        "currentTrackId": {
          "type": "string",
          "description": "Currently loaded track identifier"
        },
        "currentTrackTitle": {
          "type": "string",
          "description": "Title of currently loaded track"
        },
        "currentTrackArtist": {
          "type": "string",
          "description": "Artist of currently loaded track"
        },
        "currentTrackCoverUrl": {
          "type": "string",
          "description": "Compact cover artwork URL of currently loaded track"
        },
        "currentTrackIsPlaying": {
          "type": "boolean",
          "description": "Whether audio playback is currently playing"
        },
        "currentTrackUpdatedAtMs": {
          "type": "integer",
          "description": "Client epoch milliseconds when now-playing track info changed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created (FieldValue.serverTimestamp)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated (FieldValue.serverTimestamp)"
        }
      },
      "required": ["userId", "displayName", "createdAt", "updatedAt"]
    },
    "BugReport": {
      "title": "BugReport",
      "description": "User-submitted bug report with reporter display name, avatar, message, and timestamp",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "description": "Unique bug report identifier"
        },
        "userId": {
          "type": "string",
          "description": "Reporter Firebase Auth UID"
        },
        "reporterName": {
          "type": "string",
          "description": "Display name of the reporter at submission time"
        },
        "reporterAvatarUrl": {
          "type": "string",
          "description": "Optional avatar URL or compressed data URI of the reporter"
        },
        "message": {
          "type": "string",
          "description": "Bug description entered by user"
        },
        "appVersion": {
          "type": "string",
          "description": "SoundLapa app version string"
        },
        "createdAtMs": {
          "type": "integer",
          "description": "Client epoch milliseconds when report was sent"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when report was created"
        }
      },
      "required": [
        "reportId",
        "userId",
        "reporterName",
        "message",
        "appVersion",
        "createdAtMs",
        "createdAt"
      ]
    },
    "SavedTrack": {
      "title": "SavedTrack",
      "description": "User-saved, liked, or playlist-referenced track metadata persisted across app updates",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "trackId": {
          "type": "string",
          "description": "Canonical SoundLapa track ID"
        },
        "title": {
          "type": "string",
          "description": "Track title"
        },
        "artist": {
          "type": "string",
          "description": "Track artist name"
        },
        "genre": {
          "type": "string",
          "description": "Track genre label"
        },
        "durationMs": {
          "type": "integer",
          "description": "Track duration in milliseconds"
        },
        "sourceUri": {
          "type": "string",
          "description": "Optional remote stream or resolver URI"
        },
        "coverArtPath": {
          "type": "string",
          "description": "Optional remote artwork URL"
        },
        "accentColorHex": {
          "type": "integer",
          "description": "Primary ARGB palette value"
        },
        "secondaryColorHex": {
          "type": "integer",
          "description": "Secondary ARGB palette value"
        },
        "isUserUpload": {
          "type": "boolean",
          "description": "Whether track was uploaded by user"
        },
        "isLiked": {
          "type": "boolean",
          "description": "Whether user liked this track"
        },
        "playCount": {
          "type": "integer",
          "description": "Track play count"
        },
        "likeCount": {
          "type": "integer",
          "description": "Track like count"
        },
        "description": {
          "type": "string",
          "description": "Optional track source description"
        },
        "albumTitle": {
          "type": "string",
          "description": "Optional album title"
        },
        "trackCreatedAtMs": {
          "type": "integer",
          "description": "Client epoch timestamp when track was added"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was updated"
        }
      },
      "required": [
        "userId",
        "trackId",
        "title",
        "artist",
        "genre",
        "durationMs",
        "accentColorHex",
        "secondaryColorHex",
        "isUserUpload",
        "isLiked",
        "playCount",
        "likeCount",
        "trackCreatedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPlaylist": {
      "title": "UserPlaylist",
      "description": "User-created or imported playlist persisted in cloud",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "playlistId": {
          "type": "string",
          "description": "Canonical SoundLapa playlist ID"
        },
        "name": {
          "type": "string",
          "description": "Playlist name"
        },
        "description": {
          "type": "string",
          "description": "Optional playlist description"
        },
        "coverArtPath": {
          "type": "string",
          "description": "Optional cover artwork URL"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the playlist is pinned to top of library"
        },
        "pinnedAtMs": {
          "type": "integer",
          "description": "Epoch milliseconds when playlist was pinned"
        },
        "sortMode": {
          "type": "string",
          "description": "Track sorting mode inside the playlist"
        },
        "playlistCreatedAtMs": {
          "type": "integer",
          "description": "Client epoch timestamp when playlist was created"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when playlist was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when playlist was updated"
        }
      },
      "required": [
        "userId",
        "playlistId",
        "name",
        "playlistCreatedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPlaylistItem": {
      "title": "UserPlaylistItem",
      "description": "Ordered track entry inside a user playlist",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "playlistId": {
          "type": "string",
          "description": "Parent playlist ID"
        },
        "trackId": {
          "type": "string",
          "description": "Referenced track ID"
        },
        "position": {
          "type": "integer",
          "description": "0-based order position in playlist"
        },
        "addedAtMs": {
          "type": "integer",
          "description": "Epoch milliseconds when added"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when added"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated"
        }
      },
      "required": [
        "userId",
        "playlistId",
        "trackId",
        "position",
        "addedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudMetrics": {
      "title": "CloudMetrics",
      "description": "Zero-PII per-user Firestore storage byte usage summary for developer quota monitoring",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "storageBytes": {
          "type": "integer",
          "description": "Estimated serialized Firestore byte footprint for this user's cloud documents"
        },
        "tracksCount": {
          "type": "integer",
          "description": "Count of cloud saved track documents"
        },
        "playlistsCount": {
          "type": "integer",
          "description": "Count of cloud playlist documents"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when metrics were updated"
        }
      },
      "required": [
        "userId",
        "storageBytes",
        "tracksCount",
        "playlistsCount",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Zero-PII public user profile visible to authenticated SoundLap users for social discovery",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "isDeveloper": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "isDeveloper", "isPublic", "updatedAt"]
    },
    "UsernameHandle": {
      "title": "UsernameHandle",
      "description": "Unique @username reservation mapping lowercase handle to owner UID",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "isDeveloper": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "userId", "displayName", "isDeveloper", "isPublic", "updatedAt"]
    },
    "UserFriend": {
      "title": "UserFriend",
      "description": "Friend link inside authenticated owner's private friend list",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "friendUid": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "isDeveloper": { "type": "boolean" },
        "addedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "friendUid", "displayName", "isDeveloper", "addedAtMs", "createdAt", "updatedAt"]
    },
    "ArtistSubscription": {
      "title": "ArtistSubscription",
      "description": "Owner's subscribed artist record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "artistKey": { "type": "string" },
        "artistName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "soundCloudUrl": { "type": "string" },
        "spotifyArtistId": { "type": "string" },
        "subscribedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "artistKey", "artistName", "subscribedAtMs", "createdAt", "updatedAt"]
    },
    "BanRecord": {
      "title": "BanRecord",
      "description": "Developer-managed account ban record preventing banned users from accessing cloud data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reason": { "type": "string" },
        "bannedByUid": { "type": "string" },
        "bannedAtMs": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bannedByUid", "bannedAtMs", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile, custom identity, and synced settings for SoundLap Google Sign-In account"
    },
    "/users/{userId}/tracks/{trackDocId}": {
      "schema": { "$ref": "#/entities/SavedTrack" },
      "description": "User's saved, liked, and playlist tracks synced across installs and updates"
    },
    "/users/{userId}/playlists/{playlistDocId}": {
      "schema": { "$ref": "#/entities/UserPlaylist" },
      "description": "User's playlists synced across installs and updates"
    },
    "/users/{userId}/playlists/{playlistDocId}/items/{itemDocId}": {
      "schema": { "$ref": "#/entities/UserPlaylistItem" },
      "description": "Ordered tracks belonging to a user's playlist"
    },
    "/users/{userId}/friends/{friendUid}": {
      "schema": { "$ref": "#/entities/UserFriend" },
      "description": "User's friends list"
    },
    "/users/{userId}/artist_subscriptions/{artistKey}": {
      "schema": { "$ref": "#/entities/ArtistSubscription" },
      "description": "User's subscribed music artists"
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Zero-PII public profile projection searchable by authenticated users"
    },
    "/usernames/{handle}": {
      "schema": { "$ref": "#/entities/UsernameHandle" },
      "description": "Unique lowercase @username directory mapping to userId"
    },
    "/bug_reports/{reportId}": {
      "schema": { "$ref": "#/entities/BugReport" },
      "description": "User bug reports queried by verified developer"
    },
    "/cloud_metrics/{userId}": {
      "schema": { "$ref": "#/entities/CloudMetrics" },
      "description": "Aggregated cloud byte usage per user for developer storage monitoring"
    },
    "/banned_users/{userId}": {
      "schema": { "$ref": "#/entities/BanRecord" },
      "description": "Server-enforced ban records created/removed exclusively by verified developer"
    }
  }
}
